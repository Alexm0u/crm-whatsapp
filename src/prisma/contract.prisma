// use prisma-next

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Client {
  id        Int     @id @default(autoincrement())
  fullName  String
  phone     String
  email     String?
  notes     String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Appointment {
  id                  Int     @id @default(autoincrement())
  clientId            Int
  physiotherapistId   Int
  serviceId           Int
  startAt             DateTime
  status              String
  notes               String?
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()
}
